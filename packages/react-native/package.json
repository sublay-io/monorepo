{
  "name": "@sublay/react-native",
  "version": "8.0.0-beta.2",
  "private": false,
  "license": "Apache-2.0",
  "author": "Sublay, maintained by Yanay Tsabary",
  "description": "Sublay: Build interactive apps with social features like comments, votes, feeds, user lists, notifications, and more.",
  "keywords": [
    "sublay",
    "authentication",
    "social",
    "comments",
    "reactions",
    "moderation",
    "notifications",
    "user-management",
    "feed",
    "lists",
    "follows",
    "reporting",
    "upvotes",
    "downvotes",
    "expo",
    "react-native",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./push": {
      "react-native": {
        "types": "./dist/push.d.ts",
        "default": "./dist/push.js"
      },
      "import": {
        "types": "./dist/push.d.mts",
        "default": "./dist/push.mjs"
      },
      "require": {
        "types": "./dist/push.d.ts",
        "default": "./dist/push.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../.github/scripts/check-publish-target.mjs --package"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "push.js",
    "push.d.ts",
    "NOTICE"
  ],
  "bugs": {
    "url": "https://discord.com/invite/REKxnCJzPz"
  },
  "homepage": "https://docs.sublay.io",
  "dependencies": {
    "@sublay/core": "workspace:*"
  },
  "devDependencies": {
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@types/react": "^19.2.14",
    "react": "^19.2.3",
    "react-native": "^0.79.7",
    "react-native-keychain": "^9.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@react-native-firebase/app": "^24",
    "@react-native-firebase/messaging": "^24",
    "@reduxjs/toolkit": "^2.9.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "*",
    "react-native-keychain": "^9",
    "react-redux": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sublay-io/monorepo.git",
    "directory": "packages/react-native"
  }
}
