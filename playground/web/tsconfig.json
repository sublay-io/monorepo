{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "~shared/*": ["../../registry/shared/*"]
    }
  },
  "include": ["src", "../../registry/react"],
  // The components' env files for other frameworks (env/next.ts, ...) read
  // globals a Vite app doesn't have; the playground uses the default
  // utils/env.ts (Vite), and the registry's own typecheck covers the rest.
  "exclude": ["../../registry/react/**/env/**"]
}
