{
  "name": "@sublay/core",
  "version": "8.0.0-beta.2",
  "private": false,
  "license": "Apache-2.0",
  "author": "Sublay, maintained by Yanay Tsabary",
  "description": "Sublay: Build interactive apps with social features like comments, votes, feeds, user lists, notifications, and more.",
  "keywords": [
    "sublay",
    "authentication",
    "social",
    "comments",
    "reactions",
    "moderation",
    "notifications",
    "user-management",
    "feed",
    "lists",
    "follows",
    "reporting",
    "upvotes",
    "downvotes",
    "react",
    "react-native",
    "expo",
    "typescript"
  ],
  "bugs": {
    "url": "https://discord.com/invite/REKxnCJzPz"
  },
  "homepage": "https://docs.sublay.io",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../.github/scripts/check-publish-target.mjs --package"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.9",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jsdom": "^24.1.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.0.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^2.3.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-redux": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sublay-io/monorepo.git",
    "directory": "packages/core"
  }
}
