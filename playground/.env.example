# Copy this file to .env and fill in the values. .env is git-ignored.

# Id of the Sublay project the playground reads from and writes to.
VITE_PROJECT_ID=

# The project's JWT private key; useSignTestingJwt signs tokens for the mock users with it. Leave empty for read-only.
VITE_PRIVATE_KEY=

# Optional. API base to use instead of production, e.g. http://localhost:5001/v8. Leave empty for https://api.sublay.io/v8.
VITE_API_BASE_URL=
